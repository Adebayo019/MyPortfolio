class Person {
    constructor(name, isLazy) {
        this.name = name;
        this.isLazy = isLazy;
        this.dictionary = [];
    }
    fillDictionary() {
        if (this.isLazy) {
            this.dictionary.push("impossible");
        } else {
            this.dictionary = this.dictionary.filter(
                (word) => word !== "impossible"
            );
        }
    }
    lookup(word) {
        return this.dictionary.includes(word);
    }
}
function canFind(word, person) {
    person.fillDictionary();

    if (person.isLazy && person.lookup(word)) {
        console.log(
            `"${word}" found in ${person.name}'s dictionary. Try harder!`
        );
    } else {
        console.log(
            `"${word}" does NOT exist in ${person.name}'s dictionary! Keep going!`
        );
    }
}